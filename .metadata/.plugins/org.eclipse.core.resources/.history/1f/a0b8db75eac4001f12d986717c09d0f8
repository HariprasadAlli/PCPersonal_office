package smartInterviewsBasics;

public class MaxElementinArray {
	
	public static void main(String args[]) {
		MaxElementinArrayMethod();
	}
	
	public static void MaxElementinArrayMethod() {
		
		int[] numbers = {-2, -19, 50, 110, 100};
		int Max = numbers[0];
		for(int num : numbers) {
			if(num > Max) {
				Max = num;
			}
		}
		System.out.println(Max);
		
	}

}
