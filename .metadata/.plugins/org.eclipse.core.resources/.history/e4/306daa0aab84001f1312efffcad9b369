package basicPrograms;

public class palindrome {

	public static void main(String args[]) {
		int num = 123, rev = 0, rem;
		int temp = num;

		while (num > 0) {
			rem = num % 10; // %-remainder
			rev = (rev * 10) + rem;
			num = num / 10;

		}
		if (rev == num) {
			System.out.println("reversed number");

		} else {
			System.out.println("not reversed");
		}

	}
}
