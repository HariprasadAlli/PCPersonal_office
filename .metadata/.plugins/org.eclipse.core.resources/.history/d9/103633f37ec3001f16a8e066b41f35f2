package j_p1_baosic;

public class Hacker_javaDataTypes_2 {
	
	    public static void main(String[] args) {

	        // Define test cases in an array
	        String[] testCases = {
	            // Number of test cases
	            "-150",
	            "150000",
	            "1500000000",
	            "213333333333333333333333333333333333",
	            "-100000000000000"
	        };

	        int t = Integer.parseInt(testCases[0]); // Number of test cases

	        for (int i = 1; i <= t; i++) {
	            try {
	                long x = Long.parseLong(testCases[i]);
	                System.out.println(x + " can be fitted in:");
	                
	                if (x >= -128 && x <= 127) System.out.println("* byte");
	                if (x >= -32768 && x <= 32767) System.out.println("* short");
	                if (x >= -2147483648 && x <= 2147483647) System.out.println("* int");
	                if (x >= -9223372036854775808L && x <= 9223372036854775807L) System.out.println("* long");

	            } catch (Exception e) {
	                System.out.println(testCases[i] + " can't be fitted anywhere.");
	            }
	        }
	    }
	}



