package smartInterviewsBasics;

public class SumOfOddElementsinArray {
	
	public static void main(String args[]) {
		SumOfOddElementsinArray();
	}
	
	public static void SumOfOddElementsinArray() {
	
		int N = 5;
		int[] A = { 1, 2, 3, 4, 1};
		int sum = 0;
		for(int i = 0; i< N; i++) {
			if(A[i]%2 != 0) {
				sum += + A[i];
				
			}
		}
		System.out.println(sum);
		
	}

}
